# Copy to .fasrc.env and fill in. Gitignored.
# Sourced by scripts/fasrc_env.sh and scripts/submit.sh.

# --- connection ---
FASRC_HOST=<user>@login.rc.fas.harvard.edu
FASRC_SOCKET=$HOME/.ssh/cm-fasrc

# --- SLURM ---
# VERIFIED AGAINST THE SCHEDULER 2026-08-06, not inferred:
#   sacctmgr -nP show assoc user=<user>              -> finkbeiner_lab only
#   sbatch --test-only -A finkbeiner_lab -p gpu      -> schedules
#   sbatch --test-only -A finkbeiner_lab -p gpu_test -> schedules
#   sbatch --test-only -A siag_lab       -p siag_gpu -> "Invalid account or
#                                                       account/partition combination"
#
# This file used to ship siag_lab / siag_gpu, on the mistaken belief that the
# grant had landed. It had not, so every submission a fresh clone made failed at
# sbatch. Do not restore those values without a dry-run submit that schedules.
#
# TRAP: siag_gpu IS visible in `sinfo`, so seeing a partition listed is NOT
# evidence of membership. Only `sbatch --test-only` settles it.
FASRC_ACCOUNT=finkbeiner_lab
FASRC_PART=gpu
FASRC_PART_SMOKE=gpu_test
# Partitions are set per-sbatch file (real runs -> gpu, smokes -> gpu_test);
# override at submit time with:  scripts/submit.sh -p <partition> sbatch/<job>.sbatch

# --- storage roots ---
# netscratch is fast and purged; holylabs is persistent. Active compute uses
# netscratch. Confirm the path is writable with scripts/fasrc_preflight.sh
# before staging anything to it.
AIONFLOW_ROOT=/n/netscratch/finkbeiner_lab/Lab/<user>/aionflow

AIONFLOW_ENV=$AIONFLOW_ROOT/envs/aionflow
AIONFLOW_DATA=$AIONFLOW_ROOT/data
AIONFLOW_STAGED=$AIONFLOW_DATA/staged
AIONFLOW_STAGED_SMOKE=$AIONFLOW_DATA/staged_smoke
HF_HOME=$AIONFLOW_ROOT/hf_cache
