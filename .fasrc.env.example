# Copy to .fasrc.env and fill in. Gitignored. Analog of the old .runpod.env.
# Sourced by scripts/fasrc_env.sh and scripts/submit.sh.

# --- connection ---
FASRC_HOST=rditella@login.rc.fas.harvard.edu
FASRC_SOCKET=$HOME/.ssh/cm-fasrc

# --- SLURM ---
# Real runs charge to siag_lab and use the siag_gpu partition (32x A100).
# Requires siag_lab group membership (request via FASRC portal if not yet added).
FASRC_ACCOUNT=siag_lab
FASRC_PART=siag_gpu
FASRC_PART_SMOKE=gpu_test
# Partitions are set per-sbatch file (train.sbatch -> siag_gpu, train_smoke -> gpu_test);
# override at submit time with:  scripts/submit.sh -p <partition> sbatch/<job>.sbatch

# --- storage roots (TODO confirm a WRITABLE path; prefer netscratch for active compute) ---
# e.g. /n/netscratch/siag_lab/Lab/rditella/aionflow   (fast, purged)
#  or  /n/holylabs/LABS/siag_lab/Users/rditella/aionflow   (persistent)
AIONFLOW_ROOT=/n/netscratch/siag_lab/Lab/rditella/aionflow

AIONFLOW_ENV=$AIONFLOW_ROOT/envs/aionflow
AIONFLOW_DATA=$AIONFLOW_ROOT/data
AIONFLOW_STAGED=$AIONFLOW_DATA/staged
AIONFLOW_STAGED_SMOKE=$AIONFLOW_DATA/staged_smoke
HF_HOME=$AIONFLOW_ROOT/hf_cache
